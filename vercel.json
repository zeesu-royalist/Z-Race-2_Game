{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(glb|gltf|bin|wasm|hdr)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/cars",
      "destination": "/cars-manifest.json"
    },
    {
      "source": "/api/boats",
      "destination": "/boats-manifest.json"
    },
    {
      "source": "/api/helicopters",
      "destination": "/helicopters-manifest.json"
    },
    {
      "source": "/((?!assets/|cars-models/|boats/|Helicopters/|npc/|city-models/|cars-manifest.json|boats-manifest.json|helicopters-manifest.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
